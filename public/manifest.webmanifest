{
  "id": "/?source=pwa",
  "name": "Kijabe Hospital Queue",
  "short_name": "Kijabe Queue",
  "description": "Outpatient check-in, waiting-room display and staff console for AIC Kijabe Hospital. Install once — opens as an app and stays up to date.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#102a43",
  "theme_color": "#159ed5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["medical", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Check-in kiosk",
      "short_name": "Kiosk",
      "url": "/kiosk?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Staff console",
      "short_name": "Staff",
      "url": "/staff?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Waiting-room TV",
      "short_name": "Display",
      "url": "/display?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}
